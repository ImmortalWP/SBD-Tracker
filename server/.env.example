# SBD Tracker Server — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/sbd-tracker?retryWrites=true&w=majority

# JWT secret — use a long random string (min 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# CORS — comma-separated list of allowed origins (optional, defaults to restrictive)
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=

# Rate limiting (optional overrides)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=100
